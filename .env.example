# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Keycloak / OpenID Connect
# This may be either the Keycloak base URL or the realm URL used by the mobile app.
# Example realm URL: http://localhost:8080/realms/cooking-compass
VITE_KEYCLOAK_URL=http://localhost:8080/realms/cooking-compass

# Optional when VITE_KEYCLOAK_URL already contains /realms/<realm>
VITE_KEYCLOAK_REALM=cooking-compass

# Use the same Keycloak client configured for the web application.
VITE_KEYCLOAK_CLIENT_ID=cooking-compass-mobile
